PROJECT_NAME="FraudGuard AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# Database Configuration
# Default uses local SQLite if PostgreSQL is not configured, or set DATABASE_URL for Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fraud_detection"
DATABASE_URL="sqlite:///./fraud_detection.db"

# Model Artifacts Directory (relative to backend or absolute)
MODEL_DIR="../Credit_Card_Fraud_Detection/Models"
MODEL_FILE="xgboost_model.pkl"
THRESHOLD_FILE="xgboost_threshold.pkl"
FEATURE_COLUMNS_FILE="feature_columns.pkl"

# CORS Origins (comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
